# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments and local env files
.env
.env.*
.venv/
venv/
env/

# Packaging/build artifacts
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Logs and temporary files
*.log
*.tmp

# OS/editor noise
.DS_Store
.vscode/settings.json

# Canonical generated artifacts. Selected historical text tables already
# tracked by Git remain tracked; new large archive contents stay local.
artifacts/cross_dataset_archive/**
!artifacts/cross_dataset_archive/README.md

# Local MIDOG++ source images and generated patch images.
datasets/midogpp/raw/**
!datasets/midogpp/raw/README.md
datasets/midogpp/contract/**/patches_*/

# github agents
.github/*
.cache/
.agents/
.codex/

literature/
run_log.md
